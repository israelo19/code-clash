# Copy this file to .env and fill it in:   cp .env.example .env
# .env is in .gitignore. NEVER commit it, and never paste a real key into this example file.

# The paid API key for the companion and the document reader.
# Leave it empty to run in mock mode: fake answers, no API calls, no cost.
ANTHROPIC_API_KEY=

# Optional: which model the AI service uses.
# LLM_MODEL=claude-sonnet-5-5

# A long random secret shared by the backend and the AI service, so the AI
# service only answers the backend. Not needed while both run on your own
# machine. REQUIRED as soon as they run on different machines. Make one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# The backend reads it from its environment (it does not read this file), so
# set it there too.
# AI_SERVICE_TOKEN=
